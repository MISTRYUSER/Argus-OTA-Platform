DATABASE_URL=postgres://argus:argus_password@localhost:5432/argus_ota?sslmode=disable
REDIS_ADDR=localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=batch-events
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=argus-logs
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
# Point to a chmod-600 private key file outside Git. Never paste a key into tracked files.
DEEPSEEK_API_KEY_FILE=
AI_RUNNER=hybrid
AI_CONCURRENCY=20
AI_TASK_TIMEOUT=2m
MODE=kafka

# Real CSV/record processing is default; mocks require explicit selection.
ARGUS_PROCESSING_MODE=real
ARGUS_PYTHON=python3
# Explicit comparison order; omit BOTH for descriptive-only aggregation.
ARGUS_BASELINE_VERSION=
ARGUS_CANDIDATE_VERSION=
# Prefer multipart field metadata per recorded file; no version inference.
ARGUS_RECORD_METADATA_JSON=
# Shared account/provider/model concurrency across replicas (migration 09).
LLM_SHARED_QUOTA=true
LLM_QUOTA_SCOPE=
LLM_REQUEST_TIMEOUT=60s
LLM_QUOTA_CRASH_GRACE=30s
